{
	"name": "paude",
	"version": "0.1.0",
	"type": "module",
	"description": "Long-lived Claude sessions on a server, reachable from anywhere and shareable",
	"bin": {
		"paude": "bin/paude.js"
	},
	"author": "justfatlard",
	"license": "ISC",
	"private": true,
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run prepare:githooks && bun run build",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- pre-commit checks will not run')",
		"build": "bun run build:clean && bun run client/build.js",
		"build:clean": "rm -rf ./client/build/",
		"build:watch": "bun run build -- --watch",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"test": "bun test",
		"set-password": "bun scripts/set-password.js"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.289",
		"@vanilla-bean/components": "2.0.5",
		"@vanilla-bean/hypertether": "^1.0.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/headless": "^6.0.0",
		"@xterm/xterm": "^6.0.0",
		"argi": "github:fatlard1993/argi#fcac703",
		"dompurify": "^3.4.16",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.0",
		"nanoid": "^6.0.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"bun-types": "^1.4.2",
		"eslint": "^10.12.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^65.1.0",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^77.0.0",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9"
	}
}
